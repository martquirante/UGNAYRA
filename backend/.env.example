# ==============================================================================
# UGNAYRA — Backend Environment Configuration Template
# Copy this file to backend/.env and fill in actual values.
# NEVER commit backend/.env or expose credentials in frontend JavaScript.
# ==============================================================================

# Application Environment
APP_NAME="UGNAYRA"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila

# CORS & Frontend Origin (comma-separated if multiple, e.g. local + Vercel preview)
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection (PDO pgsql)
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection String
# - Session Pooler (IPv4 compatible, recommended for Render/XAMPP): port 5432 on pooler host
# - Transaction Pooler: port 6543 (set DB_POOL_MODE=transaction to enable emulated prepares)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_database_password_here
DB_SSLMODE=require
DB_POOL_MODE=session
DB_CONNECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# Session, Cookie & CSRF Security
# In production over HTTPS across separate origins, set SESSION_SAME_SITE=None
# and SESSION_SECURE=true. When using Vercel /api rewrites (same-site), Lax is optimal.
# ------------------------------------------------------------------------------
SESSION_NAME=ugnayra_sid
SESSION_LIFETIME=604800
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
APP_SECRET_KEY=generate_a_64_char_hex_random_secret_here

# ------------------------------------------------------------------------------
# Rate Limiting (requests per window in seconds)
# ------------------------------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=60

# ------------------------------------------------------------------------------
# Supabase API & Media Storage Configuration
# STORAGE_DRIVER=local stores files in backend/public/uploads (development)
# STORAGE_DRIVER=supabase uploads server-side to Supabase Storage (production)
# WARNING: SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY are strictly server-only.
# NEVER expose secret keys in frontend HTML/JavaScript or commit backend/.env.
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
UPLOAD_MAX_BYTES=5242880
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
SUPABASE_SECRET_KEY=<your-supabase-secret-key>
SUPABASE_JWKS_URL=https://your_project_ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=ugnayra-media
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-or-secret-key>

# Optional Direct Google Identity Services Client ID (leave blank if using Supabase Google OAuth)
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# Firebase Realtime / Firestore NoSQL Configuration (for Chat & Messaging)
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id
